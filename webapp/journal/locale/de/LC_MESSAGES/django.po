# German interface texts of the lab journal.
msgid ""
msgstr ""
"Project-Id-Version: orgsyndb-web\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Lab journal"
msgstr "Laborjournal"

msgid "Enter upper-case letters and digits, joined by single hyphens, such as AE-2."
msgstr "Großbuchstaben und Ziffern eingeben, verbunden durch einzelne Bindestriche, etwa AE-2."

msgid "Code"
msgstr "Code"

msgid "As written on the cover, such as AE-2. It cannot be changed later."
msgstr "Wie auf dem Umschlag, etwa AE-2. Er lässt sich später nicht ändern."

msgid "Another lab notebook has this code."
msgstr "Ein anderes Laborjournal hat diesen Code."

msgid "Owner"
msgstr "Inhaber"

msgid "lab notebook"
msgstr "Laborjournal"

msgid "lab notebooks"
msgstr "Laborjournale"

msgid "The code of a lab notebook cannot be changed."
msgstr "Der Code eines Laborjournals lässt sich nicht ändern."

msgid "lab notebook entry"
msgstr "Eintrag im Laborjournal"

msgid "lab notebook entries"
msgstr "Einträge im Laborjournal"

msgid "Enter a lab notebook entry as <code>/<number>, such as AE-2/8."
msgstr "Einen Eintrag im Laborjournal als <Code>/<Nummer> eingeben, etwa AE-2/8."

msgid "No lab notebook has the code %(code)s."
msgstr "Kein Laborjournal hat den Code %(code)s."

msgid "Lab notebook %(code)s saved."
msgstr "Laborjournal %(code)s gespeichert."

msgid "Lab notebooks"
msgstr "Laborjournale"

msgid "New lab notebook"
msgstr "Neues Laborjournal"

msgid "No lab notebooks."
msgstr "Keine Laborjournale."

msgid "Notebook"
msgstr "Journal"

msgid "Entries"
msgstr "Einträge"

msgid "Entry"
msgstr "Eintrag"

msgid "Procedure"
msgstr "Vorschrift"

msgid "Task steps"
msgstr "Aufgabenschritte"

msgid "No entries."
msgstr "Keine Einträge."
