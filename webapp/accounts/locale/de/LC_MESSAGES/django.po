# German interface texts of the OrgSynDB lab application.
msgid ""
msgstr ""
"Project-Id-Version: orgsyndb-web\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Personal info"
msgstr "Persönliche Angaben"

msgid "Permissions"
msgstr "Berechtigungen"

msgid "Important dates"
msgstr "Wichtige Daten"

msgid "Accounts"
msgstr "Konten"

msgid "initials"
msgstr "Kürzel"

msgid "Enter one to five letters or digits."
msgstr "Geben Sie ein bis fünf Buchstaben oder Ziffern ein."

msgid "One to five letters or digits, shown in lists."
msgstr "Ein bis fünf Buchstaben oder Ziffern, in Listen angezeigt."

msgid "Another account has these initials."
msgstr "Ein anderes Konto hat dieses Kürzel."

msgid "Sign in"
msgstr "Anmelden"

msgid "Change password"
msgstr "Passwort ändern"

msgid "Your password has been changed."
msgstr "Ihr Passwort wurde geändert."

msgid "Demo accounts"
msgstr "Demo-Konten"

#, python-format
msgid "Password for all: %(password)s"
msgstr "Passwort für alle: %(password)s"

msgid ""
"Enter at most 40 letters or digits, with single dots, hyphens or "
"underscores between them."
msgstr ""
"Geben Sie höchstens 40 Buchstaben oder Ziffern ein, mit einzelnen Punkten, "
"Bindestrichen oder Unterstrichen dazwischen."

msgid ""
"At most 40 letters or digits, with single dots, hyphens or underscores "
"between them. It cannot be changed later."
msgstr ""
"Höchstens 40 Buchstaben oder Ziffern, mit einzelnen Punkten, Bindestrichen "
"oder Unterstrichen dazwischen. Er lässt sich später nicht ändern."

msgid "Access tokens"
msgstr "Zugangsschlüssel"

msgid "access token"
msgstr "Zugangsschlüssel"

msgid "access tokens"
msgstr "Zugangsschlüssel"

msgid "New access token"
msgstr "Neuer Zugangsschlüssel"

msgid "No access tokens yet."
msgstr "Noch keine Zugangsschlüssel."

msgid "Copy the token now; it is not shown again."
msgstr "Kopieren Sie den Schlüssel jetzt; er wird nicht wieder angezeigt."

msgid "Access token “%(name)s” revoked."
msgstr "Zugangsschlüssel „%(name)s“ widerrufen."

msgid "Account"
msgstr "Konto"

msgid "Name"
msgstr "Name"

msgid "Digest"
msgstr "Prüfsumme"

msgid "Created"
msgstr "Angelegt"

msgid "Last used"
msgstr "Zuletzt benutzt"

msgid "never"
msgstr "nie"

msgid "Revoke"
msgstr "Widerrufen"

msgid "Create"
msgstr "Anlegen"

msgid "Enter 64 lower-case hexadecimal digits."
msgstr "64 hexadezimale Ziffern in Kleinbuchstaben eingeben."

msgid "This user name is reserved for Forgejo."
msgstr "Dieser Benutzername ist für Forgejo reserviert."

msgid "Another account has this email address."
msgstr "Ein anderes Konto hat diese E-Mail-Adresse."

msgid "Forgejo was not updated; manage.py forge_accounts brings it in line."
msgstr "Forgejo wurde nicht aktualisiert; manage.py forge_accounts gleicht es ab."

msgid "No access to Forgejo"
msgstr "Kein Zugang zu Forgejo"

msgid ""
"Your account has no email address, and Forgejo needs one. Ask staff to "
"give your account an email address first, then sign in to Forgejo again."
msgstr ""
"Ihr Konto hat keine E-Mail-Adresse, Forgejo braucht aber eine. Bitten Sie "
"das Laborpersonal, Ihrem Konto zuerst eine E-Mail-Adresse zu geben, und "
"melden Sie sich dann erneut bei Forgejo an."
