# Serves the site orgsyndb-deploy published last. ORGSYNDB_ADDRESS is
# Caddy's site address, :8080 (plain HTTP on port 8080) by default; a host
# name makes Caddy serve HTTPS for it instead. Mount
# your own file over /etc/caddy/Caddyfile for other settings.
# Cache-Control: no-cache makes browsers revalidate every file, so they
# show a new build at once instead of cached pages of the previous one.
{
	admin off
}

{$ORGSYNDB_ADDRESS::8080} {
	header Cache-Control "no-cache"
	handle_path /pdf/* {
		root * /var/lib/orgsyndb/current/pdf
		file_server browse
	}
	handle {
		root * /var/lib/orgsyndb/current/public
		file_server
	}
}
