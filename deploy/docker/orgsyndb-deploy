# pusher and their user name, the last two ``-`` when unknown.
PUSH_LINE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:"
                       r"[0-9]{2}Z ([0-9a-f]{40}) \S+ (\S+)")
