#!/usr/bin/env python3
"""Keep an OrgSynDB site built from Git, for the container image.

``orgsyndb-deploy run`` repeats a cycle until it is stopped: fetch the
application and the collection from their Git repositories and the
registry snapshot from the lab application, build the site when the
collection commit, the registry or the application commit differs from
the latest import the application accepted, send the application the
build's manifest, and publish the build only once the application has
accepted it. ``orgsyndb-deploy sync`` runs one cycle. ``orgsyndb-deploy
status`` prints the saved state; ``orgsyndb-deploy retry`` forgets the
failed builds, so that the next cycle tries them again. SIGHUP starts
the next cycle of ``run`` at once.

Settings come from the environment:

ORGSYNDB_COLLECTION_REPO   Git URL or path of the collection (required)
ORGSYNDB_COLLECTION_REF    branch or tag to build (default: main)
ORGSYNDB_COLLECTION_PATH   collection directory inside that repository
                           (default: the repository root)
ORGSYNDB_APP_UPDATE        true to follow the application's repository
                           (default: true)
ORGSYNDB_APP_REPO          Git URL or path of the application (default:
                           the repository the image was built from)
ORGSYNDB_APP_REF           branch or tag of the application (default:
                           the one the image was built from)
ORGSYNDB_INTERVAL          seconds between cycles (default: 300)
ORGSYNDB_PDF               true to render procedure PDFs (default: false)
ORGSYNDB_KEEP_RELEASES     published sites kept besides the current one
                           (default: 2)
ORGSYNDB_BUILD_TIMEOUT     seconds a build, and then its manifest and its
                           index, may take each (default: 3600)
ORGSYNDB_REGISTRY_URL      address of the lab application's registry
                           snapshot (default:
                           http://app:8000/lab/registry/snapshot.json)
ORGSYNDB_MANIFEST_URL      address the manifest of each build is posted
                           to (default:
                           http://app:8000/lab/collection/manifest/)
ORGSYNDB_BUILDER_TOKEN     the token the application expects on a
                           manifest; without it nothing is built
ORGSYNDB_ALLOWED_HOSTS     the host names the lab application accepts,
                           separated by commas; the first that is not *,
                           without a leading dot, is sent as the Host of
                           the snapshot's and the manifest's requests
                           (default: localhost)

The data directory (ORGSYNDB_DATA, default /var/lib/orgsyndb) holds the
collection's clone in ``collection/``, the snapshot last fetched in
``registry.json``, the releases in ``releases/``, each with the output
of ``orgsyndb index`` as ``index.json``, the symlink ``current`` to the
release being served, and ``state.json``. Every run of
``tools/orgsyndb`` has ORGSYNDB_REGISTRY naming ``registry.json``. A
cycle whose snapshot cannot be fetched builds nothing. The snapshot's
``import`` names the latest accepted import; ``current`` is pointed at
its release whenever that release exists. The application's clone is
ORGSYNDB_APP (default /opt/orgsyndb/app). ORGSYNDB_IMAGE_INFO (default
/opt/orgsyndb/image.json) names the image's record of the repository,
ref and ``deploy/docker`` tree it was built from. An application commit
whose ``deploy/docker`` tree differs needs a new image, and is not used.
"""

import http.client
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass
from pathlib import Path

sys.dont_write_bytecode = True
PROG = "orgsyndb-deploy"
IMAGE_DIR = "deploy/docker"
OUTPUTS = ("build", "public", "pdf")
REGISTRY_URL = "http://app:8000/lab/registry/snapshot.json"
MANIFEST_URL = "http://app:8000/lab/collection/manifest/"
REQUEST_TIMEOUT = 30
MANIFEST_FORMAT = 1
# The keys of an import as the snapshot names it, besides its ``id``.
IMPORT_KEYS = ("build", "commit", "snapshot", "tooling", "release",
               "language")
# The registry's vocabularies, which a snapshot holds.
VOCABULARIES = ("chemical-classes", "inventory-groups", "projects",
                "reaction-types")


class Failure(Exception):
    """A step failed; the cycle ends and the published site stays."""


class BuildFailure(Exception):
    """A build, its manifest or its index failed. ERRORS are the lines
    of the failed command's output that report an error."""

    def __init__(self, message: str, errors: list[str]) -> None:
        super().__init__(message)
        self.errors = errors


@dataclass
class Settings:
    data: Path
    app: Path
    image: dict
    collection_repo: str
    collection_ref: str
    collection_path: str
    app_update: bool
    app_repo: str
    app_ref: str
    interval: int
    pdf: bool
    keep: int
    timeout: int
    registry_url: str
    registry_host: str
    manifest_url: str
    token: str


def log(message: str) -> None:
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"{stamp} {PROG}: {message}", flush=True)


def flag(name: str, default: bool) -> bool:
    value = os.environ.get(name, "").strip().lower()
    if not value:
        return default
    if value in ("1", "true", "yes", "on"):
        return True
    if value in ("0", "false", "no", "off"):
        return False
    raise Failure(f"{name} must be true or false: {value}")


def number(name: str, default: int, least: int) -> int:
    value = os.environ.get(name, "").strip()
    if not value:
        return default
    if not value.isdigit() or int(value) < least:
        raise Failure(f"{name} must be a whole number of at least {least}: "
                      f"{value}")
    return int(value)


def request_host(allowed: str) -> str:
    """Return the Host to request the snapshot and send the manifest
    with: the first entry of
    ALLOWED, host names separated by commas, that is not ``*``, a
    leading dot dropped, or ``localhost`` when there is none."""
    for entry in allowed.split(","):
        name = entry.strip().removeprefix(".")
        if name and name != "*":
            return name
    return "localhost"


def settings() -> Settings:
    image_path = Path(os.environ.get("ORGSYNDB_IMAGE_INFO",
                                     "/opt/orgsyndb/image.json"))
    try:
        image = json.loads(image_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise Failure(f"cannot read {image_path}: {exc}") from None
    collection_repo = os.environ.get("ORGSYNDB_COLLECTION_REPO", "").strip()
    if not collection_repo:
        raise Failure("ORGSYNDB_COLLECTION_REPO is not set; name the Git "
                      "repository of the collection")
    path = os.environ.get("ORGSYNDB_COLLECTION_PATH", "").strip() or "."
    if Path(path).is_absolute() or ".." in Path(path).parts:
        raise Failure("ORGSYNDB_COLLECTION_PATH must be a relative path "
                      f"inside the repository: {path}")
    return Settings(
        data=Path(os.environ.get("ORGSYNDB_DATA", "/var/lib/orgsyndb")),
        app=Path(os.environ.get("ORGSYNDB_APP", "/opt/orgsyndb/app")),
        image=image,
        collection_repo=collection_repo,
        collection_ref=(os.environ.get("ORGSYNDB_COLLECTION_REF", "").strip()
                        or "main"),
        collection_path=path,
        app_update=flag("ORGSYNDB_APP_UPDATE", True),
        app_repo=(os.environ.get("ORGSYNDB_APP_REPO", "").strip()
                  or image["app_repo"]),
        app_ref=(os.environ.get("ORGSYNDB_APP_REF", "").strip()
                 or image["app_ref"]),
        interval=number("ORGSYNDB_INTERVAL", 300, 10),
        pdf=flag("ORGSYNDB_PDF", False),
        keep=number("ORGSYNDB_KEEP_RELEASES", 2, 0),
        timeout=number("ORGSYNDB_BUILD_TIMEOUT", 3600, 60),
        registry_url=(os.environ.get("ORGSYNDB_REGISTRY_URL", "").strip()
                      or REGISTRY_URL),
        registry_host=request_host(os.environ.get("ORGSYNDB_ALLOWED_HOSTS",
                                                  "")),
        manifest_url=(os.environ.get("ORGSYNDB_MANIFEST_URL", "").strip()
                      or MANIFEST_URL),
        token=os.environ.get("ORGSYNDB_BUILDER_TOKEN", "").strip(),
    )


# --------------------------------------------------------------------------
# Git


def git(repo: Path, *args: str) -> str:
    done = subprocess.run(["git", "-C", str(repo), *args],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise Failure(f"git {' '.join(args)} in {repo}: "
                      + (done.stderr.strip() or f"exit {done.returncode}"))
    return done.stdout.strip()


def fetch(repo: Path, url: str, ref: str) -> str:
    """Fetch ``ref`` from ``url`` into ``repo``, creating the repository
    when it does not exist, and return the fetched commit."""
    if not (repo / ".git").exists():
        repo.mkdir(parents=True, exist_ok=True)
        git(repo, "init", "--quiet")
    if git(repo, "remote").split().count("origin"):
        git(repo, "remote", "set-url", "origin", url)
    else:
        git(repo, "remote", "add", "origin", url)
    git(repo, "fetch", "--quiet", "--no-tags", "--force", "origin", ref)
    return git(repo, "rev-parse", "FETCH_HEAD^{commit}")


def head(repo: Path) -> str | None:
    if not (repo / ".git").exists():
        return None
    try:
        return git(repo, "rev-parse", "--verify", "--quiet",
                   "HEAD^{commit}")
    except Failure:
        return None


def checkout(repo: Path, commit: str) -> None:
    """Make the working tree ``commit``, keeping ignored files such as
    build output and fetched-tool caches."""
    git(repo, "checkout", "--quiet", "--force", "--detach", commit)
    git(repo, "clean", "--quiet", "-ffd")


def tree(repo: Path, commit: str, path: str) -> str | None:
    try:
        return git(repo, "rev-parse", "--verify", "--quiet",
                   f"{commit}:{path}")
    except Failure:
        return None


# --------------------------------------------------------------------------
# State


def load_state(data: Path) -> dict:
    try:
        state = json.loads((data / "state.json").read_text(encoding="utf-8"))
    except FileNotFoundError:
        state = {}
    except ValueError as exc:
        log(f"ignoring unreadable state.json: {exc}")
        state = {}
    state.setdefault("deployed", None)
    state.setdefault("failed", [])
    state.setdefault("unsent", None)
    return state


def save_state(data: Path, state: dict) -> None:
    path = data / "state.json"
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n",
                         encoding="utf-8")
    os.replace(temporary, path)


def combination(app: str, collection: str, registry: str) -> str:
    """Name what a release is built from: the application and collection
    commits and the registry snapshot's digest."""
    return f"{app}:{collection}:{registry}"


# --------------------------------------------------------------------------
# Registry


def read_snapshot(data: bytes) -> dict:
    """Return the registry snapshot DATA, UTF-8 JSON, as a table. Raise
    Failure when DATA is not a table whose ``format`` is 1 and which
    holds the four vocabularies, lists of tables each with a string
    ``key`` and ``label``, the list of substances, tables each with a
    string ``key``, a string ``digest`` and ``import``, null or a table
    of an integer ``id`` and the strings of ``IMPORT_KEYS``."""
    try:
        table = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as exc:
        raise Failure(f"the answer is not JSON: {exc}") from None
    if not (isinstance(table, dict) and type(table.get("format")) is int
            and table["format"] == 1
            and isinstance(table.get("vocabularies"), dict)
            and all(isinstance(table["vocabularies"].get(name), list)
                    for name in VOCABULARIES)
            and isinstance(table.get("substances"), list)
            and isinstance(table.get("digest"), str)
            and all(_has_strings(term, "key", "label")
                    for name in VOCABULARIES
                    for term in table["vocabularies"][name])
            and all(_has_strings(substance, "key")
                    for substance in table["substances"])
            and (table.get("import") is None
                 or _has_strings(table["import"], *IMPORT_KEYS)
                 and type(table["import"].get("id")) is int)):
        raise Failure("the answer is not a registry snapshot")
    return table


def _has_strings(entry: object, *keys: str) -> bool:
    """Whether ENTRY is a table whose KEYS are all strings."""
    return isinstance(entry, dict) and all(
        isinstance(entry.get(key), str) for key in keys)


def fetch_registry(config: Settings) -> dict | None:
    """Request the snapshot at the registry address, keep it in
    ``<data>/registry.json`` and return it. When the request fails or
    its answer is no snapshot, log it and return None: nothing is built
    without a snapshot of this cycle."""
    kept = config.data / "registry.json"
    request = urllib.request.Request(
        config.registry_url, headers={"Host": config.registry_host,
                                      "Accept": "application/json"})
    try:
        try:
            with urllib.request.urlopen(request,
                                        timeout=REQUEST_TIMEOUT) as answer:
                if answer.status != 200:
                    raise Failure(f"status {answer.status}")
                data = answer.read()
        except (OSError, http.client.HTTPException, ValueError) as exc:
            raise Failure(str(exc)) from None
        table = read_snapshot(data)
    except Failure as exc:
        log(f"cannot fetch the registry from {config.registry_url}: {exc}; "
            "nothing is built")
        return None
    temporary = kept.with_name(".registry.json")
    temporary.write_bytes(data)
    os.replace(temporary, kept)
    return table


def tool_environment(config: Settings) -> dict[str, str]:
    """The environment of a run of ``tools/orgsyndb``: this program's,
    with ORGSYNDB_REGISTRY naming the kept snapshot."""
    return {**os.environ, "ORGSYNDB_REGISTRY":
            str((config.data / "registry.json").absolute())}


# --------------------------------------------------------------------------
# Manifests


def trigger(accepted: dict | None, app: str, commit: str,
            registry: str) -> str:
    """Return why the combination of APP, COMMIT and REGISTRY is built
    after the latest accepted import ACCEPTED: ``commit`` when that has
    another collection commit, else ``registry`` when it has another
    snapshot digest, else ``tooling`` when it has another application
    commit, else ``catch-up``, which is also the trigger without an
    accepted import."""
    if accepted is None:
        return "catch-up"
    if accepted["commit"] != commit:
        return "commit"
    if accepted["snapshot"] != registry:
        return "registry"
    if accepted["tooling"] != app:
        return "tooling"
    return "catch-up"


def send(config: Settings, manifest: dict) -> dict:
    """Post MANIFEST to the manifest address and return the answer's
    table when the application answers 200 or 409. Raise Failure, with
    the reason, when it gives no answer or another one."""
    request = urllib.request.Request(
        config.manifest_url, data=json.dumps(manifest).encode("utf-8"),
        method="POST", headers={
            "Host": config.registry_host,
            "Authorization": f"Bearer {config.token}",
            "Content-Type": "application/json",
            "Accept": "application/json"})
    try:
        try:
            with urllib.request.urlopen(request,
                                        timeout=REQUEST_TIMEOUT) as answer:
                status, data = answer.status, answer.read()
        except urllib.error.HTTPError as exc:
            status, data = exc.code, exc.read()
    except (OSError, http.client.HTTPException, ValueError) as exc:
        raise Failure(str(exc) or type(exc).__name__) from None
    if status not in (200, 409):
        raise Failure(f"status {status}")
    try:
        table = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        table = None
    if not isinstance(table, dict):
        raise Failure(f"status {status} without a JSON table")
    return {**table, "status": status}


# --------------------------------------------------------------------------
# Build and publish


def error_lines(output: str) -> list[str]:
    """Return the lines of OUTPUT that contain ``: error: ``."""
    return [line.strip() for line in output.splitlines()
            if ": error: " in line]


def run_tool(config: Settings, collection: Path, command: str,
             echo: bool = False) -> str:
    """Run the checked-out application's ``orgsyndb -C COLLECTION
    COMMAND`` and return its standard output; with ECHO, copy both its
    streams to this program's. Raise BuildFailure when it cannot run,
    exits non-zero or takes longer than the build timeout, with its
    error lines."""
    args = [str(config.app / "tools" / "orgsyndb"), "-C", str(collection),
            command]
    if echo:
        log("running " + " ".join(args))
    try:
        done = subprocess.run(args, timeout=config.timeout,
                              capture_output=True, text=True,
                              env=tool_environment(config))
    except subprocess.TimeoutExpired:
        raise BuildFailure(f"{command} took longer than {config.timeout} s",
                           []) from None
    except OSError as exc:
        raise BuildFailure(f"cannot run {command}: {exc}", []) from None
    if echo:
        sys.stdout.write(done.stdout)
        sys.stdout.flush()
        sys.stderr.write(done.stderr)
        sys.stderr.flush()
    if done.returncode != 0:
        raise BuildFailure(
            f"{command} exited {done.returncode}",
            error_lines(done.stdout) + error_lines(done.stderr))
    return done.stdout


def collection_half(text: str) -> dict:
    """Return the ``language``, ``procedures`` and ``sequences`` of
    TEXT, the output of ``orgsyndb manifest``; raise BuildFailure when
    it is not a JSON table of them."""
    try:
        table = json.loads(text)
    except ValueError as exc:
        raise BuildFailure(f"manifest printed no JSON: {exc}", []) from None
    keys = ("language", "procedures", "sequences")
    if not (isinstance(table, dict) and all(key in table for key in keys)):
        raise BuildFailure("manifest printed no table of "
                           + ", ".join(keys), [])
    return {key: table[key] for key in keys}


def release_name(serial: int, app: str, commit: str) -> str:
    """Return the name of release SERIAL, built with APP from the
    collection COMMIT."""
    return f"{serial:06d}-{app[:10]}-{commit[:10]}"


def stage(config: Settings, collection: Path, index_text: str,
          name: str) -> None:
    """Copy the build of COLLECTION and INDEX_TEXT, as ``index.json``,
    into the new release NAME, without publishing it."""
    releases = config.data / "releases"
    partial = releases / f".{name}"
    shutil.rmtree(partial, ignore_errors=True)
    partial.mkdir(parents=True)
    shutil.copytree(collection / "public", partial / "public",
                    symlinks=True)
    if config.pdf and (collection / "pdf").is_dir():
        shutil.copytree(collection / "pdf", partial / "pdf", symlinks=True)
    (partial / "index.json").write_text(index_text, encoding="utf-8")
    os.replace(partial, releases / name)


def current_release(config: Settings) -> str | None:
    """Return the name of the release ``current`` points at, or None."""
    link = config.data / "current"
    return os.path.basename(os.readlink(link)) if link.is_symlink() \
        else None


def point_current(config: Settings, state: dict, name: str) -> None:
    """Point ``current`` at the release NAME, replacing the link
    atomically, forget the staged release whose answer was lost, which
    NAME supersedes or is, and prune the releases."""
    temporary = config.data / ".current"
    if temporary.is_symlink() or temporary.exists():
        temporary.unlink()
    temporary.symlink_to(Path("releases") / name)
    os.replace(temporary, config.data / "current")
    state["unsent"] = None
    prune(config.data / "releases", name, config.keep)


def prune(releases: Path, current: str | None, keep: int,
          spare: str | None = None) -> None:
    """Remove all releases but ``current``, ``spare``, a staged release
    whose answer was lost, and the ``keep`` newest others, and partial
    copies left by an interrupted publish."""
    names = sorted((entry.name for entry in releases.iterdir()
                    if entry.is_dir() and not entry.name.startswith(".")
                    and entry.name not in (current, spare)),
                   reverse=True)
    for name in names[keep:]:
        shutil.rmtree(releases / name)
    for entry in releases.iterdir():
        if entry.name.startswith("."):
            shutil.rmtree(entry, ignore_errors=True)


def deployed(app: str, commit: str, registry: str, release: str) -> dict:
    """Return the state's record of the published RELEASE, built with
    APP from the collection COMMIT and the registry digest REGISTRY."""
    return {"app": app, "collection": commit, "registry": registry,
            "release": release,
            "time": time.strftime("%Y-%m-%dT%H:%M:%S%z")}


def restore(config: Settings, state: dict, accepted: dict | None) -> None:
    """Point ``current`` at the release of the latest accepted import
    ACCEPTED when that release exists and ``current`` points elsewhere,
    and record it in the state as published."""
    if accepted is None:
        return
    name = accepted["release"]
    if not name or name != Path(name).name or name.startswith(".") \
            or not (config.data / "releases" / name).is_dir():
        return
    if current_release(config) != name:
        point_current(config, state, name)
        log(f"published release {name}, which the application accepted")
    if (state["deployed"] or {}).get("release") != name:
        state["deployed"] = deployed(accepted["tooling"], accepted["commit"],
                                     accepted["snapshot"], name)


def record_failure(state: dict, app: str, commit: str,
                   registry: str) -> None:
    """Record the combination of APP, COMMIT and REGISTRY as failed,
    keeping the 50 latest."""
    state["failed"] = [*state["failed"],
                       combination(app, commit, registry)][-50:]


def attempt(config: Settings, state: dict, app: str, commit: str,
            snapshot: dict) -> str:
    """Build ``commit`` of the collection with ``app``, both checked out,
    and the kept SNAPSHOT, send the application its manifest, and
    publish the build when the application accepts it. Return what came
    of it:

    - ``published``: accepted; ``current`` points at the release, which
      the state records;
    - ``failed``: the build failed and the application has its report,
      or it refused the build; the combination is recorded as failed;
    - ``stale``: the application judged the build stale; its release is
      removed and nothing is recorded;
    - ``unsent``: the application gave no answer or another one; a
      staged release is kept and nothing is recorded.
    """
    registry = snapshot["digest"]
    accepted = snapshot.get("import")
    log(f"building collection {commit[:10]} with application {app[:10]} "
        f"and registry {registry[:10]}")
    collection = config.data / "collection" / config.collection_path
    manifest = {
        "format": MANIFEST_FORMAT, "build": str(uuid.uuid4()),
        "commit": commit,
        "committed_at": git(config.data / "collection", "log", "-1",
                            "--format=%cI", commit),
        "base": None if accepted is None else accepted["id"],
        "snapshot": registry, "tooling": app,
        "trigger": trigger(accepted, app, commit, registry)}
    try:
        run_tool(config, collection, "pdf" if config.pdf else "build",
                 echo=True)
        half = collection_half(run_tool(config, collection, "manifest"))
        index_text = run_tool(config, collection, "index")
        state["serial"] = state.get("serial", 0) + 1
        name = release_name(state["serial"], app, commit)
        stage(config, collection, index_text, name)
    except (BuildFailure, OSError) as exc:
        errors = getattr(exc, "errors", None) or [str(exc)]
        log(f"failed: {exc}; the published site is unchanged")
        try:
            send(config, {**manifest, "outcome": "refused",
                          "errors": errors})
        except Failure as reason:
            log(f"cannot send the manifest: {reason}; the failure is "
                "reported again by the next cycle")
            return "unsent"
        record_failure(state, app, commit, registry)
        return "failed"
    release = config.data / "releases" / name
    try:
        answer = send(config, {**manifest, "outcome": "built",
                               "release": name, **half})
    except Failure as reason:
        log(f"cannot send the manifest: {reason}; release {name} is kept "
            "until the application names it")
        state["unsent"] = name
        return "unsent"
    outcome = answer.get("outcome")
    if answer["status"] == 200 and outcome == "accepted":
        point_current(config, state, name)
        state["deployed"] = deployed(app, commit, registry, name)
        log(f"published release {name}")
        return "published"
    if answer["status"] == 200 and outcome == "refused":
        shutil.rmtree(release, ignore_errors=True)
        record_failure(state, app, commit, registry)
        log(f"the application refused release {name}; the published site "
            "is unchanged")
        return "failed"
    if answer["status"] == 409 and outcome == "stale":
        shutil.rmtree(release, ignore_errors=True)
        log(f"the application found release {name} stale; the next cycle "
            "builds again")
        return "stale"
    log(f"cannot send the manifest: status {answer['status']} with "
        f"outcome {outcome!r}; release {name} is kept until the "
        "application names it")
    state["unsent"] = name
    return "unsent"


# --------------------------------------------------------------------------
# Cycle


def wanted_app(config: Settings, current: str | None) -> str | None:
    """Fetch the application and return the commit to move to, or None
    to stay on ``current``."""
    if not config.app_update:
        return None
    try:
        target = fetch(config.app, config.app_repo, config.app_ref)
    except Failure as exc:
        log(f"cannot fetch the application: {exc}")
        return None
    if target == current:
        return None
    if tree(config.app, target, IMAGE_DIR) != config.image["deploy_tree"]:
        log(f"application {target[:10]} changes {IMAGE_DIR}/ and needs a "
            "new image; rebuild it with docker compose build --pull. "
            f"Staying on {(current or 'none')[:10]}")
        return None
    return target


def accepted_as(accepted: dict | None, app: str, commit: str,
                registry: str, releases: Path) -> bool:
    """Whether the latest accepted import ACCEPTED was built with APP
    from the collection COMMIT and the registry digest REGISTRY, and its
    release is in RELEASES."""
    return (accepted is not None and accepted["tooling"] == app
            and accepted["commit"] == commit
            and accepted["snapshot"] == registry
            and bool(accepted["release"])
            and (releases / accepted["release"]).is_dir())


def cycle(config: Settings) -> None:
    """Run one cycle: fetch both repositories and the snapshot, point
    ``current`` at the latest accepted import's release, and build,
    report and publish the first combination of an application commit,
    the collection commit and the registry that the application has not
    accepted and that did not fail before, newest application first."""
    data = config.data
    (data / "releases").mkdir(parents=True, exist_ok=True)
    state = load_state(data)

    old_app = head(config.app)
    if old_app is None:
        raise Failure(f"{config.app} is not a Git checkout of the "
                      "application")
    new_app = wanted_app(config, old_app)

    repo = data / "collection"
    try:
        commit = fetch(repo, config.collection_repo, config.collection_ref)
    except Failure as exc:
        log(f"cannot fetch the collection: {exc}")
        commit = head(repo)
        if commit is None:
            return
    marker = repo / config.collection_path / "orgsyndb.toml"
    snapshot = fetch_registry(config)
    if snapshot is None:
        return
    registry = snapshot["digest"]
    accepted = snapshot.get("import")
    restore(config, state, accepted)
    if not config.token:
        log("ORGSYNDB_BUILDER_TOKEN is not set; nothing is built until the "
            "builder has the token the application expects")
        save_state(data, state)
        return

    candidates = []
    if new_app is not None:
        candidates.append(new_app)
    candidates.append(old_app)
    # The state is saved even when a step raises, so that a serial
    # given to a staged release is never handed out twice.
    try:
        for app in candidates:
            if accepted_as(accepted, app, commit, registry,
                           data / "releases"):
                break
            if combination(app, commit, registry) in state["failed"]:
                continue
            checkout(config.app, app)
            checkout(repo, commit)
            if not marker.is_file():
                log(f"collection {commit[:10]} holds no "
                    f"{config.collection_path}/orgsyndb.toml; set "
                    "ORGSYNDB_COLLECTION_PATH")
                record_failure(state, app, commit, registry)
                break
            if attempt(config, state, app, commit, snapshot) != "failed":
                break
    finally:
        # Only the newest staged release whose answer was lost is kept
        # besides those pruning keeps, so failed sends cannot fill the
        # volume.
        prune(data / "releases", current_release(config), config.keep,
              state["unsent"])
        save_state(data, state)
    # Stay on the application of the published site, or on the old one.
    keep = (state["deployed"] or {}).get("app") or old_app
    if head(config.app) != keep and keep in candidates:
        checkout(config.app, keep)


def run(config: Settings) -> int:
    wake = threading.Event()
    signal.signal(signal.SIGHUP, lambda *_: wake.set())
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log(f"collection {config.collection_repo} ({config.collection_ref}); "
        + (f"application {config.app_repo} ({config.app_ref})"
           if config.app_update else "application updates off")
        + f"; every {config.interval} s")
    while True:
        try:
            cycle(config)
        except (Failure, OSError) as exc:
            log(f"error: {exc}")
        wake.wait(config.interval)
        wake.clear()


def main(argv: list[str]) -> int:
    command = argv[0] if argv else "run"
    if command in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if command not in ("run", "sync", "status", "retry") or len(argv) > 1:
        print(f"usage: {PROG} [run|sync|status|retry|help]",
              file=sys.stderr)
        return 2
    try:
        data = Path(os.environ.get("ORGSYNDB_DATA", "/var/lib/orgsyndb"))
        if command == "status":
            print(json.dumps(load_state(data), indent=2))
            return 0
        if command == "retry":
            state = load_state(data)
            state["failed"] = []
            save_state(data, state)
            return 0
        config = settings()
        if command == "sync":
            cycle(config)
            return 0
        return run(config)
    except (Failure, OSError) as exc:
        print(f"{PROG}: error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
