# Gate


class Refusal(Exception):
    """A check ends with the answer STATUS and the text LINES."""

    def __init__(self, status: int, *lines: str) -> None:
        super().__init__(status, *lines)
        self.status = status
        self.lines = list(lines)


def step_errors(stdout: str, stderr: str) -> list[str]:
    """Return the error lines of a failed step's STDOUT and STDERR, or,
    when neither has one, the last non-blank line of STDERR, else of
    STDOUT, else nothing."""
    found = error_lines(stdout) + error_lines(stderr)
    if found:
        return found
    for text in (stderr, stdout):
        lines = [line.strip() for line in text.splitlines() if line.strip()]
        if lines:
            return lines[-1:]
    return []


class Gate:
    """The checks of the gate: one at a time, each with a directory of
    its own under ``<data>/check/`` and one deadline.

    ``lock`` is held while a check runs. ``stop`` ends a running check
    from another thread: it kills the process group of its step and
    starts no further step.
    """

    def __init__(self, config: Settings) -> None:
        self.config = config
        self.root = config.data / "check"
        self.lock = threading.Lock()
        self._guard = threading.Lock()
        self._group: int | None = None
        self._directory: Path | None = None
        self._stopping = False

    @property
    def seconds(self) -> int:
        """The seconds a check may take."""
        return self.config.gate_timeout - GATE_MARGIN

    def too_slow(self) -> Refusal:
        return Refusal(503, f"the check took too long: more than "
                            f"{self.seconds} seconds")

    def clear(self) -> None:
        """Remove every check directory under ``<data>/check/``, keeping
        the check's clone of the application."""
        if not self.root.is_dir():
            return
        for entry in self.root.iterdir():
            if entry.name != "app":
                shutil.rmtree(entry, ignore_errors=True)

    def stop(self) -> None:
        """Stop the running check, if any: kill its step's process group,
        start no further step, wait up to 10 seconds for the check to
        end, and remove its directory."""
        with self._guard:
            self._stopping = True
            if self._group is not None:
                try:
                    os.killpg(self._group, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        if self.lock.acquire(timeout=10):
            self.lock.release()
        with self._guard:
            directory = self._directory
        if directory is not None:
            shutil.rmtree(directory, ignore_errors=True)

    def step(self, args: list[str], deadline: float,
             stdin: BinaryIO | None = None,
             env: dict[str, str] | None = None) -> tuple[int, str, str]:
        """Run ARGS in a new process group, its standard input STDIN or
        nothing, with the environment ENV or this program's, and return
        its exit status, standard output and standard error. Raise
        Refusal 503 when the DEADLINE, a ``time.monotonic`` value,
        passes first, after killing the group, when ARGS cannot run, and
        when the gate stops."""
        left = deadline - time.monotonic()
        if left <= 0:
            raise self.too_slow()
        with self._guard:
            if self._stopping:
                raise Refusal(503, "the builder is stopping; push again")
            try:
                process = subprocess.Popen(
                    args, stdin=stdin or subprocess.DEVNULL,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                    env=env, process_group=0)
            except OSError as exc:
                raise Refusal(503, f"cannot run {args[0]}: {exc}") from None
            self._group = process.pid
        try:
            try:
                out, err = process.communicate(timeout=left)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.communicate()
                raise self.too_slow() from None
        finally:
            with self._guard:
                self._group = None
                stopping = self._stopping
        if stopping:
            raise Refusal(503, "the builder is stopping; push again")
        return (process.returncode, out.decode("utf-8", "replace"),
                err.decode("utf-8", "replace"))

    def git(self, deadline: float, *args: str,
            stdin: BinaryIO | None = None) -> str:
        """Run ``git ARGS`` as a step and return its output. Raise
        Refusal 503, with Git's reason, when it exits non-zero."""
        status, out, err = self.step(["git", *args], deadline, stdin)
        if status != 0:
            reason = (err.strip().splitlines() or [f"exit {status}"])[-1]
            raise Refusal(503, f"git {' '.join(args)}: {reason}")
        return out.strip()

    def application(self, deadline: float) -> Path:
        """Bring the check's clone of the application to the commit of
        the published release the saved state names, or to the cycle's
        checked-out commit when none is published, keeping its ignored
        files, and copy into it the cycle clone's tool caches
        (``TOOL_CACHES``) that it lacks, keeping their modes; return the
        clone."""
        wanted = ((load_state(self.config.data)["deployed"] or {})
                  .get("app") or head(self.config.app))
        if wanted is None:
            raise Refusal(503, f"{self.config.app} is not a Git checkout of "
                               "the application")
        app = self.root / "app"
        if not (app / ".git").exists():
            app.mkdir(parents=True, exist_ok=True)
            self.git(deadline, "-C", str(app), "init", "--quiet")
        self.git(deadline, "-C", str(app), "fetch", "--quiet", "--no-tags",
                 "--force", str(self.config.app.absolute()), wanted)
        self.git(deadline, "-C", str(app), "checkout", "--quiet", "--force",
                 "--detach", wanted)
        self.git(deadline, "-C", str(app), "clean", "--quiet", "-ffd")
        for name in TOOL_CACHES:
            source, target = self.config.app / name, app / name
            if source.is_dir() and not target.exists():
                partial = app / f"{name}.partial"
                shutil.rmtree(partial, ignore_errors=True)
                shutil.copytree(source, partial, symlinks=True)
                os.replace(partial, target)
        return app

    def checkout(self, deadline: float, directory: Path, commit: str
                 ) -> Path:
        """Index the pack ``<DIRECTORY>/pack`` into a new repository in
        DIRECTORY, point its ``main`` at COMMIT and check it out; return
        the repository. Raise Refusal 422 when the pack cannot be
        indexed or does not hold COMMIT, and, before anything is checked
        out, when the tree of COMMIT holds a symbolic link, naming each
        link."""
        repo = directory / "collection"
        self.git(deadline, "init", "--quiet", "--initial-branch", "main",
                 str(repo))
        with open(directory / "pack", "rb") as pack:
            status, out, err = self.step(
                ["git", "-C", str(repo), "index-pack", "--stdin"],
                deadline, pack)
        if status != 0:
            raise Refusal(422, *(step_errors(out, err)
                                 or ["the pack cannot be read"]))
        status, _out, _err = self.step(
            ["git", "-C", str(repo), "cat-file", "-e", f"{commit}^{{commit}}"],
            deadline)
        if status != 0:
            raise Refusal(422, f"the pack does not hold commit {commit}")
        links = [entry.partition("\t")[2] for entry in self.git(
            deadline, "-C", str(repo), "ls-tree", "-r", "-z", commit
        ).split("\0") if entry.startswith("120000 ")]
        if links:
            raise Refusal(422, *(f"symbolic links are not allowed: {path}"
                                 for path in links))
        self.git(deadline, "-C", str(repo), "update-ref", "refs/heads/main",
                 commit)
        self.git(deadline, "-C", str(repo), "checkout", "--quiet", "--force",
                 "main")
        return repo

    def tool(self, deadline: float, app: Path, collection: Path,
             registry: Path, command: str) -> str:
        """Run ``tools/orgsyndb -C COLLECTION COMMAND`` of the clone APP
        as a step, ORGSYNDB_REGISTRY naming REGISTRY, and return its
        standard output. Raise Refusal 422 with its error lines when it
        exits non-zero."""
        status, out, err = self.step(
            [str(app / "tools" / "orgsyndb"), "-C", str(collection),
             command], deadline,
            env={**os.environ, "ORGSYNDB_REGISTRY": str(registry)})
        if status != 0:
            raise Refusal(422, *(step_errors(out, err)
                                 or [f"{command} exited {status}"]))
        return out

    def ask(self, deadline: float, half: dict) -> list[str]:
        """Post the collection HALF to the check address with the
        builder's token and return the errors the application found.
        Raise Refusal 503 when it gives no answer of status 200 holding
        a list of texts under ``errors``; any other status, 2xx
        included, is no answer. Raise it saying that the check took too
        long when the answer has not arrived whole by the DEADLINE."""
        config = self.config
        try:
            status, data = transfer(
                config.check_url, deadline, {
                    "Host": config.registry_host,
                    "Authorization": f"Bearer {config.token}",
                    "Content-Type": "application/json",
                    "Accept": "application/json"},
                json.dumps(half).encode("utf-8"))
        except TimeoutError:
            raise self.too_slow() from None
        except (OSError, http.client.HTTPException, ValueError) as exc:
            raise Refusal(503, "the lab application gave no answer: "
                               + (str(exc) or type(exc).__name__)) from None
        if status != 200:
            raise Refusal(503, "the lab application answered the check "
                               f"with status {status}")
        try:
            errors = json.loads(data.decode("utf-8"))["errors"]
        except (UnicodeDecodeError, ValueError, KeyError, TypeError):
            errors = None
        if not (isinstance(errors, list)
                and all(isinstance(error, str) for error in errors)):
            raise Refusal(503, "the lab application's answer to the check "
                               "is not a list of errors")
        return errors

    def check(self, commit: str,
              receive: Callable[[Path, float], None]) -> Refusal:
        """Check COMMIT, whose pack RECEIVE writes to the file it is
        given by the deadline it is given, a ``time.monotonic`` value,
        raising TimeoutError when it cannot and OSError when the body
        ends early; return the answer, status 200 without lines when
        the commit passes.

        The caller holds ``lock``. The check's directory is removed
        when it ends, whatever the answer."""
        config = self.config
        deadline = time.monotonic() + self.seconds
        self.root.mkdir(parents=True, exist_ok=True)
        directory = Path(tempfile.mkdtemp(prefix="run-", dir=self.root))
        with self._guard:
            self._directory = directory
        try:
            try:
                receive(directory / "pack", deadline)
            except TimeoutError:
                raise self.too_slow() from None
            except OSError as exc:
                raise Refusal(400, f"cannot read the pack: {exc}") from None
            app = self.application(deadline)
            registry = directory / "registry.json"
            try:
                request_registry(config, registry, deadline)
            except TimeoutError:
                raise self.too_slow() from None
            except Failure as exc:
                raise Refusal(503, "cannot fetch the registry snapshot: "
                                   f"{exc}") from None
            collection = (self.checkout(deadline, directory, commit)
                          / config.collection_path)
            self.tool(deadline, app, collection, registry, "validate")
            output = self.tool(deadline, app, collection, registry,
                               "manifest")
            try:
                half = collection_half(output)
            except BuildFailure as exc:
                raise Refusal(503, str(exc)) from None
            errors = self.ask(deadline, half)
            if errors:
                return Refusal(422, *(line for error in errors
                                      for line in error.splitlines()))
            return Refusal(200)
        except Refusal as answer:
            return answer
        finally:
            shutil.rmtree(directory, ignore_errors=True)
            with self._guard:
                self._directory = None


class CheckHandler(BaseHTTPRequestHandler):
    """The builder's server's requests: ``POST /check`` with a pack, and
    ``POST /wake``."""

    server_version = PROG
    protocol_version = "HTTP/1.1"
    # The bytes of the request's body not read yet.
    unread = 0

    @property
    def gate(self) -> Gate:
        return self.server.gate  # type: ignore[attr-defined]

    @property
    def woken(self) -> threading.Event:
        """The event a wake-up sets, which ``run`` waits for."""
        return self.server.woken  # type: ignore[attr-defined]

    def log_message(self, format: str, *args: object) -> None:
        """Log nothing per request; ``check`` logs each check."""

    def answer(self, status: int, lines: list[str]) -> None:
        """Answer STATUS with LINES as UTF-8 text, closing the
        connection."""
        body = "".join(f"{line}\n" for line in lines).encode("utf-8")
        self.close_connection = True
        try:
            self.send_response(status)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Connection", "close")
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)
        except OSError:
            pass

    def other(self) -> None:
        """Answer a request that is not a POST."""
        if self.path == "/check" and not self.gate.config.gate_token:
            self.answer(503, [NOT_CONFIGURED])
        elif self.path in ("/check", "/wake"):
            self.answer(405, ["only POST is allowed"])
        else:
            self.answer(404, ["not found"])

    do_GET = do_HEAD = do_PUT = do_DELETE = do_PATCH = other

    def signed(self, *tokens: str) -> bool:
        """Whether the request carries ``Authorization: Bearer <token>``
        with one of TOKENS, compared in constant time; an empty token
        matches nothing."""
        scheme, _, given = self.headers.get("Authorization", "").partition(
            " ")
        matches = [hmac.compare_digest(given.encode("utf-8"),
                                       token.encode("utf-8"))
                   for token in tokens if token]
        return scheme == "Bearer" and any(matches)

    def copy(self, target: Path, deadline: float) -> None:
        """Read the rest of the body into the file TARGET by DEADLINE, a
        ``time.monotonic`` value. Raise TimeoutError when the deadline
        passes first, and OSError when the body ends early."""
        with open(target, "wb") as out:
            while self.unread > 0:
                seconds = deadline - time.monotonic()
                if seconds <= 0:
                    raise TimeoutError("the deadline passed")
                self.connection.settimeout(seconds)
                chunk = self.rfile.read1(min(self.unread, 1 << 20))
                if not chunk:
                    raise OSError("the body ended early")
                out.write(chunk)
                self.unread -= len(chunk)

    def discard(self) -> None:
        """Read and drop what arrives of the rest of the body, for at
        most GATE_DISCARD seconds."""
        deadline = time.monotonic() + GATE_DISCARD
        try:
            while self.unread > 0:
                seconds = deadline - time.monotonic()
                if seconds <= 0:
                    return
                self.connection.settimeout(seconds)
                chunk = self.rfile.read1(min(self.unread, 1 << 20))
                if not chunk:
                    return
                self.unread -= len(chunk)
        except OSError:
            return

    def do_POST(self) -> None:
        self.unread = 0
        try:
            self.take()
        finally:
            self.discard()

    def wake(self) -> None:
        """Answer a POST to ``/wake``: 202, setting ``woken``, when it
        carries the gate's or the builder's token, else 401. A body is
        read and dropped afterwards."""
        given = self.headers.get("Content-Length", "")
        self.unread = int(given) if given.isdigit() else 0
        config = self.gate.config
        if not self.signed(config.gate_token, config.token):
            self.answer(401, ["the request does not carry the gate's or "
                              "the builder's token"])
            return
        self.woken.set()
        log("woken up; the next cycle starts now or after this one")
        self.answer(202, [])

    def take(self) -> None:
        """Answer a POST: a wake-up, or a check of the pack it carries,
        or refuse it."""
        if self.path == "/wake":
            self.wake()
            return
        if self.path != "/check":
            self.answer(404, ["not found"])
            return
        if not self.gate.config.gate_token:
            self.answer(503, [NOT_CONFIGURED])
            return
        if not self.signed(self.gate.config.gate_token):
            self.answer(401, ["the request does not carry the gate's token"])
            return
        given = self.headers.get("Content-Length", "")
        if not given.isdigit():
            self.answer(411, ["the request has no Content-Length"])
            return
        self.unread = int(given)
        if self.unread > GATE_LIMIT:
            self.answer(413, [f"the pack is larger than {GATE_LIMIT} "
                              "bytes"])
            return
        commit = self.headers.get("X-Orgsyndb-Commit", "").strip()
        if not GATE_COMMIT.fullmatch(commit):
            self.answer(400, ["X-Orgsyndb-Commit does not hold a commit id "
                              "of 40 hexadecimal digits"])
            return
        commit = commit.lower()
        gate = self.gate
        if not gate.lock.acquire(blocking=False):
            self.answer(503, ["the gate is busy with another check; push "
                              "again"])
            return
        try:
            result = gate.check(commit, self.copy)
        finally:
            gate.lock.release()
        log(f"check of collection {commit[:10]}: {result.status}"
            + (f", {result.lines[0]}" if result.lines else ""))
        self.answer(result.status, result.lines)


def serve_gate(config: Settings, woken: threading.Event
               ) -> tuple[ThreadingHTTPServer, Gate]:
    """Start the builder's server on ORGSYNDB_GATE_BIND and
    ORGSYNDB_GATE_PORT in a thread, after removing check directories a
    previous run left; a wake-up sets WOKEN. Return the server and its
    gate. Raise OSError when it cannot listen."""
    gate = Gate(config)
    gate.clear()
    server = ThreadingHTTPServer((config.gate_bind, config.gate_port),
                                 CheckHandler)
    server.daemon_threads = True
    server.gate = gate  # type: ignore[attr-defined]
    server.woken = woken  # type: ignore[attr-defined]
    threading.Thread(target=server.serve_forever, name="gate",
                     daemon=True).start()
    log("serving wake-ups and "
        + ("checks" if config.gate_token else "no checks")
        + f" on {config.gate_bind}:{config.gate_port}")
    return server, gate


def run(config: Settings) -> int:
    """Repeat the cycle every ORGSYNDB_INTERVAL seconds, or at once on
    SIGHUP or a wake-up, running the builder's server beside it while
    ORGSYNDB_GATE_TOKEN or ORGSYNDB_BUILDER_TOKEN is set, until SIGTERM
    ends it with exit status 0. A SIGHUP or wake-up during a cycle
    starts one more after it, however many arrive. Raise OSError when
    the server cannot listen."""
    wake = threading.Event()
    signal.signal(signal.SIGHUP, lambda *_: wake.set())
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log(f"collection {config.collection_repo} ({config.collection_ref}); "
        + (f"application {config.app_repo} ({config.app_ref})"
           if config.app_update else "application updates off")
        + f"; every {config.interval} s")
    served = (serve_gate(config, wake)
              if config.gate_token or config.token else None)
    try:
        while True:
            try:
                cycle(config)
            except (Failure, OSError) as exc:
                log(f"error: {exc}")
            wake.wait(config.interval)
            wake.clear()
    finally:
        if served is not None:
            server, gate = served
            gate.stop()
            server.shutdown()
            server.server_close()


def main(argv: list[str]) -> int:
    command = argv[0] if argv else "run"
    if command in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if command not in ("run", "sync", "status", "retry") or len(argv) > 1:
        print(f"usage: {PROG} [run|sync|status|retry|help]",
              file=sys.stderr)
        return 2
    try:
        data = Path(os.environ.get("ORGSYNDB_DATA", "/var/lib/orgsyndb"))
        if command == "status":
            print(json.dumps(load_state(data), indent=2))
            return 0
        if command == "retry":
            state = load_state(data)
            state["failed"] = []
            save_state(data, state)
            return 0
        config = settings()
        if command == "sync":
            cycle(config)
            return 0
        return run(config)
    except (Failure, OSError) as exc:
        print(f"{PROG}: error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
