#!/usr/bin/env python3
"""Keep an OrgSynDB site built from Git, for the container image.

``orgsyndb-deploy run`` repeats a cycle until it is stopped: fetch the
application and the collection from their Git repositories and the
collection's registry from the lab application, build the site when any
of them has changed, and publish it only when the build succeeds.
``orgsyndb-deploy sync`` runs one cycle. ``orgsyndb-deploy status``
prints the saved state; ``orgsyndb-deploy retry`` forgets the failed
builds, so that the next cycle tries them again. SIGHUP starts the next
cycle of ``run`` at once.

Settings come from the environment:

ORGSYNDB_COLLECTION_REPO   Git URL or path of the collection (required)
ORGSYNDB_COLLECTION_REF    branch or tag to build (default: main)
ORGSYNDB_COLLECTION_PATH   collection directory inside that repository
                           (default: the repository root)
ORGSYNDB_APP_UPDATE        true to follow the application's repository
                           (default: true)
ORGSYNDB_APP_REPO          Git URL or path of the application (default:
                           the repository the image was built from)
ORGSYNDB_APP_REF           branch or tag of the application (default:
                           the one the image was built from)
ORGSYNDB_INTERVAL          seconds between cycles (default: 300)
ORGSYNDB_PDF               true to render procedure PDFs (default: false)
ORGSYNDB_KEEP_RELEASES     published sites kept besides the current one
                           (default: 2)
ORGSYNDB_BUILD_TIMEOUT     seconds a build, and then its index, may
                           take (default: 3600)
ORGSYNDB_REGISTRY_URL      address of the lab application's registry
                           snapshot (default:
                           http://app:8000/lab/registry/snapshot.json)
ORGSYNDB_ALLOWED_HOSTS     the host names the lab application accepts,
                           separated by commas; the first that is not *,
                           without a leading dot, is sent as the Host of
                           the snapshot's request (default: localhost)

The data directory (ORGSYNDB_DATA, default /var/lib/orgsyndb) holds the
collection's clone in ``collection/``, the snapshot last fetched in
``registry.json`` and its address in ``registry.source``, the published
sites in ``releases/``, each with the output of ``orgsyndb index`` as
``index.json``, the symlink ``current`` to the site being served, and
``state.json``. Every run of ``tools/orgsyndb`` has ORGSYNDB_REGISTRY
naming ``registry.json``; when the address does not answer, the copy of
the same address is used, and without one nothing is built. The
application's clone is ORGSYNDB_APP (default /opt/orgsyndb/app).
ORGSYNDB_IMAGE_INFO (default /opt/orgsyndb/image.json) names the image's
record of the repository, ref and ``deploy/docker`` tree it was built
from. An application commit whose ``deploy/docker`` tree differs needs a
new image, and is not used.
"""

import http.client
import json
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.request
from dataclasses import dataclass
from pathlib import Path

sys.dont_write_bytecode = True
PROG = "orgsyndb-deploy"
IMAGE_DIR = "deploy/docker"
OUTPUTS = ("build", "public", "pdf")
REGISTRY_URL = "http://app:8000/lab/registry/snapshot.json"
REGISTRY_TIMEOUT = 30
# The registry's vocabularies, which a snapshot holds.
VOCABULARIES = ("chemical-classes", "inventory-groups", "projects",
                "reaction-types")


class Failure(Exception):
    """A step failed; the cycle ends and the published site stays."""


@dataclass
class Settings:
    data: Path
    app: Path
    image: dict
    collection_repo: str
    collection_ref: str
    collection_path: str
    app_update: bool
    app_repo: str
    app_ref: str
    interval: int
    pdf: bool
    keep: int
    timeout: int
    registry_url: str
    registry_host: str


def log(message: str) -> None:
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"{stamp} {PROG}: {message}", flush=True)


def flag(name: str, default: bool) -> bool:
    value = os.environ.get(name, "").strip().lower()
    if not value:
        return default
    if value in ("1", "true", "yes", "on"):
        return True
    if value in ("0", "false", "no", "off"):
        return False
    raise Failure(f"{name} must be true or false: {value}")


def number(name: str, default: int, least: int) -> int:
    value = os.environ.get(name, "").strip()
    if not value:
        return default
    if not value.isdigit() or int(value) < least:
        raise Failure(f"{name} must be a whole number of at least {least}: "
                      f"{value}")
    return int(value)


def request_host(allowed: str) -> str:
    """Return the Host to request the snapshot with: the first entry of
    ALLOWED, host names separated by commas, that is not ``*``, a
    leading dot dropped, or ``localhost`` when there is none."""
    for entry in allowed.split(","):
        name = entry.strip().removeprefix(".")
        if name and name != "*":
            return name
    return "localhost"


def settings() -> Settings:
    image_path = Path(os.environ.get("ORGSYNDB_IMAGE_INFO",
                                     "/opt/orgsyndb/image.json"))
    try:
        image = json.loads(image_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise Failure(f"cannot read {image_path}: {exc}") from None
    collection_repo = os.environ.get("ORGSYNDB_COLLECTION_REPO", "").strip()
    if not collection_repo:
        raise Failure("ORGSYNDB_COLLECTION_REPO is not set; name the Git "
                      "repository of the collection")
    path = os.environ.get("ORGSYNDB_COLLECTION_PATH", "").strip() or "."
    if Path(path).is_absolute() or ".." in Path(path).parts:
        raise Failure("ORGSYNDB_COLLECTION_PATH must be a relative path "
                      f"inside the repository: {path}")
    return Settings(
        data=Path(os.environ.get("ORGSYNDB_DATA", "/var/lib/orgsyndb")),
        app=Path(os.environ.get("ORGSYNDB_APP", "/opt/orgsyndb/app")),
        image=image,
        collection_repo=collection_repo,
        collection_ref=(os.environ.get("ORGSYNDB_COLLECTION_REF", "").strip()
                        or "main"),
        collection_path=path,
        app_update=flag("ORGSYNDB_APP_UPDATE", True),
        app_repo=(os.environ.get("ORGSYNDB_APP_REPO", "").strip()
                  or image["app_repo"]),
        app_ref=(os.environ.get("ORGSYNDB_APP_REF", "").strip()
                 or image["app_ref"]),
        interval=number("ORGSYNDB_INTERVAL", 300, 10),
        pdf=flag("ORGSYNDB_PDF", False),
        keep=number("ORGSYNDB_KEEP_RELEASES", 2, 0),
        timeout=number("ORGSYNDB_BUILD_TIMEOUT", 3600, 60),
        registry_url=(os.environ.get("ORGSYNDB_REGISTRY_URL", "").strip()
                      or REGISTRY_URL),
        registry_host=request_host(os.environ.get("ORGSYNDB_ALLOWED_HOSTS",
                                                  "")),
    )


# --------------------------------------------------------------------------
# Git


def git(repo: Path, *args: str) -> str:
    done = subprocess.run(["git", "-C", str(repo), *args],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise Failure(f"git {' '.join(args)} in {repo}: "
                      + (done.stderr.strip() or f"exit {done.returncode}"))
    return done.stdout.strip()


def fetch(repo: Path, url: str, ref: str) -> str:
    """Fetch ``ref`` from ``url`` into ``repo``, creating the repository
    when it does not exist, and return the fetched commit."""
    if not (repo / ".git").exists():
        repo.mkdir(parents=True, exist_ok=True)
        git(repo, "init", "--quiet")
    if git(repo, "remote").split().count("origin"):
        git(repo, "remote", "set-url", "origin", url)
    else:
        git(repo, "remote", "add", "origin", url)
    git(repo, "fetch", "--quiet", "--no-tags", "--force", "origin", ref)
    return git(repo, "rev-parse", "FETCH_HEAD^{commit}")


def head(repo: Path) -> str | None:
    if not (repo / ".git").exists():
        return None
    try:
        return git(repo, "rev-parse", "--verify", "--quiet",
                   "HEAD^{commit}")
    except Failure:
        return None


def checkout(repo: Path, commit: str) -> None:
    """Make the working tree ``commit``, keeping ignored files such as
    build output and fetched-tool caches."""
    git(repo, "checkout", "--quiet", "--force", "--detach", commit)
    git(repo, "clean", "--quiet", "-ffd")


def tree(repo: Path, commit: str, path: str) -> str | None:
    try:
        return git(repo, "rev-parse", "--verify", "--quiet",
                   f"{commit}:{path}")
    except Failure:
        return None


# --------------------------------------------------------------------------
# State


def load_state(data: Path) -> dict:
    try:
        state = json.loads((data / "state.json").read_text(encoding="utf-8"))
    except FileNotFoundError:
        state = {}
    except ValueError as exc:
        log(f"ignoring unreadable state.json: {exc}")
        state = {}
    state.setdefault("deployed", None)
    state.setdefault("failed", [])
    return state


def save_state(data: Path, state: dict) -> None:
    path = data / "state.json"
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n",
                         encoding="utf-8")
    os.replace(temporary, path)


def combination(app: str, collection: str, registry: str) -> str:
    """Name what a release is built from: the application and collection
    commits and the registry snapshot's digest."""
    return f"{app}:{collection}:{registry}"


# --------------------------------------------------------------------------
# Registry


def snapshot_digest(data: bytes) -> str:
    """Return the ``digest`` of the registry snapshot DATA, UTF-8 JSON.
    Raise Failure when DATA is not a table whose ``format`` is 1 and
    which holds the four vocabularies, lists of tables each with a
    string ``key`` and ``label``, and the list of substances, tables
    each with a string ``key``."""
    try:
        table = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError) as exc:
        raise Failure(f"the answer is not JSON: {exc}") from None
    if not (isinstance(table, dict) and type(table.get("format")) is int
            and table["format"] == 1
            and isinstance(table.get("vocabularies"), dict)
            and all(isinstance(table["vocabularies"].get(name), list)
                    for name in VOCABULARIES)
            and isinstance(table.get("substances"), list)
            and isinstance(table.get("digest"), str)
            and all(_has_strings(term, "key", "label")
                    for name in VOCABULARIES
                    for term in table["vocabularies"][name])
            and all(_has_strings(substance, "key")
                    for substance in table["substances"])):
        raise Failure("the answer is not a registry snapshot")
    return table["digest"]


def _has_strings(entry: object, *keys: str) -> bool:
    """Whether ENTRY is a table whose KEYS are all strings."""
    return isinstance(entry, dict) and all(
        isinstance(entry.get(key), str) for key in keys)


def fetch_registry(config: Settings) -> str | None:
    """Request the snapshot at the registry address, keep it in
    ``<data>/registry.json`` and the address in ``<data>/registry.source``,
    and return its digest. When the request fails or its answer is no
    snapshot, log it and return the digest of the copy kept for the same
    address, or None when there is none."""
    kept = config.data / "registry.json"
    source = config.data / "registry.source"
    request = urllib.request.Request(
        config.registry_url, headers={"Host": config.registry_host,
                                      "Accept": "application/json"})
    try:
        try:
            with urllib.request.urlopen(request,
                                        timeout=REGISTRY_TIMEOUT) as answer:
                if answer.status != 200:
                    raise Failure(f"status {answer.status}")
                data = answer.read()
        except (OSError, http.client.HTTPException, ValueError) as exc:
            raise Failure(str(exc)) from None
        digest = snapshot_digest(data)
    except Failure as exc:
        log(f"cannot fetch the registry from {config.registry_url}: {exc}")
        try:
            same = source.read_text(encoding="utf-8").strip() == (
                config.registry_url)
            digest = snapshot_digest(kept.read_bytes()) if same else None
        except (OSError, Failure):
            digest = None
        if digest is None:
            log("no copy of this registry is kept; nothing is built")
        else:
            log(f"using the copy of the registry, digest {digest}")
        return digest
    source.unlink(missing_ok=True)
    temporary = kept.with_name(".registry.json")
    temporary.write_bytes(data)
    os.replace(temporary, kept)
    source.write_text(config.registry_url + "\n", encoding="utf-8")
    return digest


def tool_environment(config: Settings) -> dict[str, str]:
    """The environment of a run of ``tools/orgsyndb``: this program's,
    with ORGSYNDB_REGISTRY naming the kept snapshot."""
    return {**os.environ, "ORGSYNDB_REGISTRY":
            str((config.data / "registry.json").absolute())}


# --------------------------------------------------------------------------
# Build and publish


def build(config: Settings) -> Path:
    """Build the checked-out collection with the checked-out
    application; return the collection directory."""
    collection = (config.data / "collection" / config.collection_path)
    command = [str(config.app / "tools" / "orgsyndb"), "-C",
               str(collection), "pdf" if config.pdf else "build"]
    log("running " + " ".join(command))
    try:
        done = subprocess.run(command, timeout=config.timeout,
                              env=tool_environment(config))
    except subprocess.TimeoutExpired:
        raise Failure(f"the build took longer than {config.timeout} s")
    except OSError as exc:
        raise Failure(f"cannot run the build: {exc}") from None
    if done.returncode != 0:
        raise Failure(f"the build exited {done.returncode}")
    return collection


def index(config: Settings, collection: Path) -> str:
    """Return the output of the checked-out application's ``orgsyndb
    index`` for COLLECTION. Raise Failure when it fails or takes longer
    than the build timeout."""
    command = [str(config.app / "tools" / "orgsyndb"), "-C",
               str(collection), "index"]
    try:
        done = subprocess.run(command, timeout=config.timeout,
                              capture_output=True, text=True,
                              env=tool_environment(config))
    except subprocess.TimeoutExpired:
        raise Failure(f"the index took longer than {config.timeout} s")
    except OSError as exc:
        raise Failure(f"cannot run the index: {exc}") from None
    if done.returncode != 0:
        raise Failure(f"the index exited {done.returncode}: "
                      + done.stderr.strip())
    return done.stdout


def publish(config: Settings, collection: Path, index_text: str,
            serial: int, app: str, commit: str) -> str:
    """Copy the build and INDEX_TEXT, as ``index.json``, into a new
    release and point ``current`` at it."""
    releases = config.data / "releases"
    name = f"{serial:06d}-{app[:10]}-{commit[:10]}"
    release = releases / name
    partial = releases / f".{name}"
    shutil.rmtree(partial, ignore_errors=True)
    partial.mkdir(parents=True)
    shutil.copytree(collection / "public", partial / "public",
                    symlinks=True)
    if config.pdf and (collection / "pdf").is_dir():
        shutil.copytree(collection / "pdf", partial / "pdf", symlinks=True)
    (partial / "index.json").write_text(index_text, encoding="utf-8")
    os.replace(partial, release)
    link = config.data / "current"
    temporary = config.data / ".current"
    if temporary.is_symlink() or temporary.exists():
        temporary.unlink()
    temporary.symlink_to(Path("releases") / name)
    os.replace(temporary, link)
    prune(releases, name, config.keep)
    return name


def prune(releases: Path, current: str, keep: int) -> None:
    """Remove all releases but ``current`` and the ``keep`` newest others,
    and partial copies left by an interrupted publish."""
    names = sorted((entry.name for entry in releases.iterdir()
                    if entry.is_dir() and not entry.name.startswith(".")
                    and entry.name != current), reverse=True)
    for name in names[keep:]:
        shutil.rmtree(releases / name)
    for entry in releases.iterdir():
        if entry.name.startswith("."):
            shutil.rmtree(entry, ignore_errors=True)


def attempt(config: Settings, state: dict, app: str, commit: str,
            registry: str) -> bool:
    """Build ``commit`` of the collection with ``app``, both checked out,
    and the kept snapshot of digest ``registry``, and write its index;
    publish both on success, and record the release in the state's
    ``deployed``. Record a failed combination, a failed index among
    them, so it is not built again."""
    log(f"building collection {commit[:10]} with application {app[:10]} "
        f"and registry {registry[:10]}")
    try:
        collection = build(config)
        index_text = index(config, collection)
        serial = state.get("serial", 0) + 1
        name = publish(config, collection, index_text, serial, app, commit)
    except (Failure, OSError) as exc:
        log(f"failed: {exc}; the published site is unchanged")
        state["failed"] = [*state["failed"],
                           combination(app, commit, registry)][-50:]
        return False
    state["serial"] = serial
    state["deployed"] = {"app": app, "collection": commit,
                         "registry": registry, "release": name,
                         "time": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    log(f"published release {name}")
    return True


# --------------------------------------------------------------------------
# Cycle


def wanted_app(config: Settings, current: str | None) -> str | None:
    """Fetch the application and return the commit to move to, or None
    to stay on ``current``."""
    if not config.app_update:
        return None
    try:
        target = fetch(config.app, config.app_repo, config.app_ref)
    except Failure as exc:
        log(f"cannot fetch the application: {exc}")
        return None
    if target == current:
        return None
    if tree(config.app, target, IMAGE_DIR) != config.image["deploy_tree"]:
        log(f"application {target[:10]} changes {IMAGE_DIR}/ and needs a "
            "new image; rebuild it with docker compose build --pull. "
            f"Staying on {(current or 'none')[:10]}")
        return None
    return target


def cycle(config: Settings) -> None:
    data = config.data
    (data / "releases").mkdir(parents=True, exist_ok=True)
    state = load_state(data)
    deployed = state["deployed"] or {}
    published = (data / "current").is_dir()

    old_app = head(config.app)
    if old_app is None:
        raise Failure(f"{config.app} is not a Git checkout of the "
                      "application")
    new_app = wanted_app(config, old_app)

    repo = data / "collection"
    try:
        commit = fetch(repo, config.collection_repo, config.collection_ref)
    except Failure as exc:
        log(f"cannot fetch the collection: {exc}")
        commit = head(repo)
        if commit is None:
            return
    marker = repo / config.collection_path / "orgsyndb.toml"
    registry = fetch_registry(config)
    if registry is None:
        return

    candidates = []
    if new_app is not None:
        candidates.append(new_app)
    candidates.append(old_app)
    for app in candidates:
        if (published and deployed.get("app") == app
                and deployed.get("collection") == commit
                and deployed.get("registry") == registry):
            break
        if combination(app, commit, registry) in state["failed"]:
            continue
        checkout(config.app, app)
        checkout(repo, commit)
        if not marker.is_file():
            log(f"collection {commit[:10]} holds no "
                f"{config.collection_path}/orgsyndb.toml; set "
                "ORGSYNDB_COLLECTION_PATH")
            state["failed"] = [*state["failed"],
                               combination(app, commit, registry)][-50:]
            break
        if attempt(config, state, app, commit, registry):
            break
    # Stay on the application of the published site, or on the old one.
    keep = (state["deployed"] or {}).get("app") or old_app
    if head(config.app) != keep and keep in candidates:
        checkout(config.app, keep)
    save_state(data, state)


def run(config: Settings) -> int:
    wake = threading.Event()
    signal.signal(signal.SIGHUP, lambda *_: wake.set())
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    log(f"collection {config.collection_repo} ({config.collection_ref}); "
        + (f"application {config.app_repo} ({config.app_ref})"
           if config.app_update else "application updates off")
        + f"; every {config.interval} s")
    while True:
        try:
            cycle(config)
        except (Failure, OSError) as exc:
            log(f"error: {exc}")
        wake.wait(config.interval)
        wake.clear()


def main(argv: list[str]) -> int:
    command = argv[0] if argv else "run"
    if command in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if command not in ("run", "sync", "status", "retry") or len(argv) > 1:
        print(f"usage: {PROG} [run|sync|status|retry|help]",
              file=sys.stderr)
        return 2
    try:
        data = Path(os.environ.get("ORGSYNDB_DATA", "/var/lib/orgsyndb"))
        if command == "status":
            print(json.dumps(load_state(data), indent=2))
            return 0
        if command == "retry":
            state = load_state(data)
            state["failed"] = []
            save_state(data, state)
            return 0
        config = settings()
        if command == "sync":
            cycle(config)
            return 0
        return run(config)
    except (Failure, OSError) as exc:
        print(f"{PROG}: error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
