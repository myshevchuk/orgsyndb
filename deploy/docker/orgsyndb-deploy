CHECK_URL = "http://app:8000/lab/collection/check/"
GATE_PORT = 8091
GATE_BIND = "0.0.0.0"
GATE_TIMEOUT = 150
# Seconds a check ends before the hook stops waiting for its answer.
GATE_MARGIN = 10
# The largest pack a check takes, in bytes.
GATE_LIMIT = 200_000_000
GATE_COMMIT = re.compile(r"[0-9a-fA-F]{40}")
# The answer of a check while ORGSYNDB_GATE_TOKEN is empty.
NOT_CONFIGURED = "the gate is not configured: ORGSYNDB_GATE_TOKEN is empty"
# Seconds the check server reads and discards a body it did not take.
GATE_DISCARD = 2
# The ignored directories of the application's clone that hold the
# tools a build fetches, which the check's clone copies.
TOOL_CACHES = (".emacs-batch", ".tools")
REQUEST_TIMEOUT = 30
MANIFEST_FORMAT = 1
# The keys of an import as the snapshot names it, besides its ``id``.
IMPORT_KEYS = ("build", "commit", "snapshot", "tooling", "release",
               "language")
# The registry's vocabularies, which a snapshot holds.
VOCABULARIES = ("chemical-classes", "inventory-groups", "projects",
                "reaction-types")


class Failure(Exception):
    """A step failed; the cycle ends and the published site stays."""


class BuildFailure(Exception):
    """A build or its manifest failed. ERRORS are the lines
    of the failed command's output that report an error."""

    def __init__(self, message: str, errors: list[str]) -> None:
        super().__init__(message)
        self.errors = errors


