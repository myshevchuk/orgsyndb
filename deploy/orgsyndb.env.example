# Settings of deploy/compose.yaml. Copy to orgsyndb.env and fill in.

# The collection's Git repository: lab/collection in Forgejo, which
# forge-setup creates and the builder reads without signing in. Another
# https:// or ssh:// URL, or a path inside the container, works too, but
# only Forgejo's repository has the gate.
ORGSYNDB_COLLECTION_REPO=http://forge:3000/lab/collection.git
# The branch or tag to build.
ORGSYNDB_COLLECTION_REF=main
# The collection's directory inside the repository, if not its root.
#ORGSYNDB_COLLECTION_PATH=.

# Follow the application's repository. Off, the application stays at the
# commit the image was built from.
ORGSYNDB_APP_UPDATE=true
# The application's repository and branch or tag; by default those the
# image was built from.
#ORGSYNDB_APP_REPO=https://github.com/myshevchuk/orgsyndb.git
#ORGSYNDB_APP_REF=main

# Seconds between checks for new commits.
ORGSYNDB_INTERVAL=300
# Render one PDF per procedure, served under /pdf/.
ORGSYNDB_PDF=false
# Published sites kept besides the current one.
ORGSYNDB_KEEP_RELEASES=2
# The lab application's registry snapshot, which the builder fetches
# before every build; ORGSYNDB_ALLOWED_HOSTS below gives its Host.
#ORGSYNDB_REGISTRY_URL=http://app:8000/lab/registry/snapshot.json
# Where the builder sends the manifest of each build, signed with
# ORGSYNDB_BUILDER_TOKEN below.
#ORGSYNDB_MANIFEST_URL=http://app:8000/lab/collection/manifest/

# Caddy's site address; :8080 serves plain HTTP. For HTTPS, mount a
# Caddyfile of your own over /etc/caddy/Caddyfile in the web service.
#ORGSYNDB_ADDRESS=:8080

# The lab application's database: PostgreSQL in the db service. Choose a
# password; ORGSYNDB_DATABASE_URL must repeat the three values, as
# postgres://<user>:<password>@db:5432/<database>.
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=lab
ORGSYNDB_DATABASE_URL=postgres://lab:change-this-password@db:5432/lab

# The lab application's secret key, which signs sign-ins: a long random
# text, kept secret. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
ORGSYNDB_SECRET_KEY=replace-with-a-generated-key
# The token the builder signs the manifest of each build with, and the
# application checks: a long random text, kept secret. Without it the
# builder publishes nothing. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ORGSYNDB_BUILDER_TOKEN=replace-with-a-generated-token
# The host names the site is reached by, separated by commas; the
# application refuses requests for any other. Keep app: Forgejo and the
# builder reach the application by it.
ORGSYNDB_ALLOWED_HOSTS=localhost,127.0.0.1,app
# Debug pages with details of every error; never on a reachable site.
#ORGSYNDB_DEBUG=false
# Demo mode, for test deployments only: the next start fills an empty
# database with invented records, whose accounts share a password shown
# on the sign-in page. Never on a stack that keeps real records.
#ORGSYNDB_DEMO=false
# Caddy forwards /lab/ to this address.
#ORGSYNDB_APP_UPSTREAM=app:8000

# The address people reach the site at, without a trailing slash;
# Forgejo is at <ORGSYNDB_URL>/git/.
ORGSYNDB_URL=http://localhost:8080
# The lab application's address on the compose network, which Forgejo's
# server uses for the OpenID token, user info and keys.
#ORGSYNDB_APP_INTERNAL_URL=http://app:8000

# Forgejo signs people in through the lab application, an OpenID
# provider whose ID tokens this RSA private key signs: PEM in base64 on
# one line, kept secret; without it the provider is off. Generate one
# with
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
ORGSYNDB_OIDC_KEY=replace-with-a-generated-key
# The secret Forgejo signs in to the provider with; forge-setup gives it
# to Forgejo. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ORGSYNDB_FORGE_CLIENT_SECRET=replace-with-a-generated-secret
# The password of Forgejo's admin account orgsyndb, which forge-setup
# creates and the lab application uses to block deactivated accounts.
# Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ORGSYNDB_FORGE_PASSWORD=replace-with-a-generated-password
# Forgejo's API, on the compose network.
ORGSYNDB_FORGE_URL=http://forge:3000/api/v1
# The password of the PostgreSQL role forge, which forge-db creates with
# Forgejo's database on db. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FORGE_DB_PASSWORD=replace-with-a-generated-password
# Caddy forwards /git/ to this address.
#ORGSYNDB_FORGE_UPSTREAM=forge:3000

# The gate: Forgejo's hook sends every push to main of lab/collection to
# the builder's check, which refuses a commit an import would refuse.
# The token signs the hook's requests, the checks and the push log's
# wake-ups: a long random text, kept secret, not the builder's token.
# Without it the builder's check refuses every request and Forgejo
# refuses every push to main. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ORGSYNDB_GATE_TOKEN=replace-with-another-generated-token
# The builder's check, which the hook posts to.
#ORGSYNDB_GATE_URL=http://builder:8091/check
# Seconds the hook waits for the check's answer; the check itself stops
# 10 seconds sooner, and answers that it took too long.
#ORGSYNDB_GATE_TIMEOUT=150
# Where the builder's check asks the lab application to check the
# collection, signed with ORGSYNDB_BUILDER_TOKEN.
#ORGSYNDB_CHECK_URL=http://app:8000/lab/collection/check/

# The builder's wake-up: Forgejo's push log hook, after a push to main,
# and the lab application, after a registry change, post to it, so that
# the builder starts a cycle at once rather than after
# ORGSYNDB_INTERVAL seconds.
ORGSYNDB_WAKE_URL=http://builder:8091/wake
# The push log, on the volume pushes: Forgejo appends a line naming the
# pusher of each push to main, and the builder reads it for every
# import's pusher.
#ORGSYNDB_PUSH_LOG=/var/lib/orgsyndb-pushes/pushes.log

# A push mirror of lab/collection, which forge-setup adds: an https://
# address of a repository elsewhere, and the user name and token that
# may push to it. Forgejo pushes every change to it. The mirror
# overwrites its target, all branches and tags, and deletes every
# branch only the target has: name a repository used for nothing else.
# Empty, forge-setup changes no mirror.
ORGSYNDB_MIRROR_URL=
ORGSYNDB_MIRROR_USER=
ORGSYNDB_MIRROR_TOKEN=

# Database dumps in backups/ beside compose.yaml: hours between dumps,
# and how many to keep.
#ORGSYNDB_BACKUP_HOURS=24
#ORGSYNDB_KEEP_BACKUPS=14
