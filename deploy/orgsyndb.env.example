# Settings of deploy/compose.yaml. Copy to orgsyndb.env and fill in.

# The collection's Git repository: an https:// or ssh:// URL, or a path
# inside the container, such as a repository mounted from this machine.
ORGSYNDB_COLLECTION_REPO=ssh://git@git.example.org/lab/procedures.git
# The branch or tag to build.
ORGSYNDB_COLLECTION_REF=main
# The collection's directory inside the repository, if not its root.
#ORGSYNDB_COLLECTION_PATH=.

# Follow the application's repository. Off, the application stays at the
# commit the image was built from.
ORGSYNDB_APP_UPDATE=true
# The application's repository and branch or tag; by default those the
# image was built from.
#ORGSYNDB_APP_REPO=https://github.com/myshevchuk/orgsyndb.git
#ORGSYNDB_APP_REF=main

# Seconds between checks for new commits.
ORGSYNDB_INTERVAL=300
# Render one PDF per procedure, served under /pdf/.
ORGSYNDB_PDF=false
# Published sites kept besides the current one.
ORGSYNDB_KEEP_RELEASES=2

# Caddy's site address; :8080 serves plain HTTP. For HTTPS, mount a
# Caddyfile of your own over /etc/caddy/Caddyfile in the web service.
#ORGSYNDB_ADDRESS=:8080

# The lab application's database: PostgreSQL in the db service. Choose a
# password; ORGSYNDB_DATABASE_URL must repeat the three values, as
# postgres://<user>:<password>@db:5432/<database>.
POSTGRES_USER=lab
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=lab
ORGSYNDB_DATABASE_URL=postgres://lab:change-this-password@db:5432/lab

# The lab application's secret key, which signs sign-ins: a long random
# text, kept secret. Generate one with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
ORGSYNDB_SECRET_KEY=replace-with-a-generated-key
# The host names the site is reached by, separated by commas; the
# application refuses requests for any other.
ORGSYNDB_ALLOWED_HOSTS=localhost,127.0.0.1
# Debug pages with details of every error; never on a reachable site.
#ORGSYNDB_DEBUG=false
# Demo mode, for test deployments only: the next start fills an empty
# database with invented records, whose accounts share a password shown
# on the sign-in page. Never on a stack that keeps real records.
#ORGSYNDB_DEMO=false
# The collection index the application reads; by default that of the
# release the web service serves.
#ORGSYNDB_INDEX=/var/lib/orgsyndb/current/index.json
# Caddy forwards /lab/ to this address.
#ORGSYNDB_APP_UPSTREAM=app:8000

# Database dumps in backups/ beside compose.yaml: hours between dumps,
# and how many to keep.
#ORGSYNDB_BACKUP_HOURS=24
#ORGSYNDB_KEEP_BACKUPS=14
